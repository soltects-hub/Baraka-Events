# Contact form submission endpoint (src/components/Contact.tsx).
# Sign up at https://formspree.io (free), create a form, and paste the
# endpoint it gives you here. Without this, the contact form on the
# homepage and /contact page cannot send anywhere and will show an error.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Google Maps Store Locator (src/components/StoreLocator.tsx).
# BOTH are required before the locator renders. With either missing, the
# location section falls back to the existing keyless Google Maps iframe,
# which is why the site works fine without them.
#
# 1. Google Cloud Console > APIs & Services: create a project, enable
#    "Maps JavaScript API", and enable billing (required even on the free tier).
# 2. Credentials > Create credentials > API key. Then restrict it:
#      Application restrictions : HTTP referrers
#        https://www.barakaevents.com/*
#        https://*.vercel.app/*        (preview deployments)
#        http://localhost:*/*          (local dev)
#      API restrictions         : Maps JavaScript API only
#    A Maps JS key is visible in client-side code by design — referrer
#    restriction is what stops it being used on someone else's site.
# 3. Google Maps Platform > Map Management > Create Map ID, type "JavaScript",
#    map type "Vector". Advanced markers need this; DEMO_MAP_ID is not usable
#    in production.
# 4. Add both to Vercel > Project > Settings > Environment Variables, then
#    redeploy. Vite inlines VITE_* vars at build time, so a redeploy is needed.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
