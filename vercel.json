{
  "redirects": [
    { "source": "/wedding-planner/", "destination": "/services/wedding-planning", "statusCode": 301 },
    { "source": "/corporate-event-planner/", "destination": "/services/corporate-events", "statusCode": 301 },
    { "source": "/birthday-planners/", "destination": "/services/birthday-events", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/experiences", "destination": "/experiences.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/team", "destination": "/team.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/services/:slug", "destination": "/services/:slug.html" },
    { "source": "/((?!.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/baraka-site.zip",
      "headers": [
        { "key": "Content-Type", "value": "application/zip" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"baraka-site.zip\"" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://www.googletagmanager.com https://formspree.io https://*.doubleclick.net https://*.googleadservices.com https://www.google.com; frame-src https://www.google.com https://www.googletagmanager.com https://*.doubleclick.net; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
